# ==========================================================
# CONFIGURACIÓN PARA CPANEL Y BASE DE DATOS MYSQL
# ==========================================================

# Base de datos MySQL en cPanel
# Formato: mysql://USUARIO_MYSQL:CONTRASENA@localhost:3306/NOMBRE_BASE_DATOS
# (En cPanel, el usuario y la base suelen llevar el prefijo de tu cuenta, ej: alina_user:Pass@localhost:3306/alina_shop)
DATABASE_URL="mysql://alina_user:PasswordSeguro2026*@localhost:3306/alina_shop"

# Payphone Ecuador API v3
PAYPHONE_APP_ID="dummy_app_id"
PAYPHONE_CLIENT_ID="dummy_client_id"
PAYPHONE_TOKEN="dummy_payphone_token"
PAYPHONE_IS_SANDBOX="true"

# Secretos de Sesión y Autenticación Admin
AUTH_SECRET="alina-shop-super-secret-jwt-key-2026"
ADMIN_PASSWORD_DEFAULT="AlinaAdmin2026*"

# Tienda y Dominio Oficial
NEXT_PUBLIC_APP_URL="https://alinashop.ec"
NEXT_PUBLIC_WHATSAPP_NUMBER="593985890956"

# Entorno de Node.js en cPanel
NODE_ENV="production"
PORT=3000
